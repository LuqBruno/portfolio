# Endereço público final, sem barra no fim. Ativa canonical, hreflang, sitemap e Open Graph absolutos.
# No GitHub Actions ele é calculado automaticamente a partir do repositório.
NEXT_PUBLIC_SITE_URL=

# Subdiretório de publicação (ex.: /portfolio). Vazio para domínio raiz ou repositório <usuario>.github.io.
NEXT_PUBLIC_BASE_PATH=

# Defina como true somente quando o endereço final estiver confirmado.
SITE_ALLOW_INDEXING=false
