{
  "name": "bruno-luque-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node scripts/postbuild.mjs",
    "preview": "node scripts/preview.mjs",
