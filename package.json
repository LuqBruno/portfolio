    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@webgpu/types": "^0.1.74",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "typescript": "5.9.3"
  }
}
